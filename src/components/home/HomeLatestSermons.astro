---
import { getCollection } from 'astro:content';
import SeriesCard from '../SeriesCard.astro';
import { SITE } from '../../data/site';
import { url } from '../../lib/url';

const allSeries = (await getCollection('sermons')).sort((a, b) => a.data.order - b.data.order);
const currentSeries = allSeries.find((s) => s.data.featured) ?? allSeries[0];
const recentSeries = allSeries.filter((s) => s.id !== currentSeries?.id).slice(0, 3);
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="flex flex-col justify-between gap-4 border-b border-stone-300 pb-6 sm:flex-row sm:items-end">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent-hover">Teaching</p>
      <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
        Latest Sermon Series
      </h2>
    </div>
    <a
      href={url('/sermons')}
      class="inline-flex items-center gap-1.5 text-sm font-bold text-stone-900 hover:text-accent-hover transition-colors"
    >
      <span>Browse all {allSeries.length} series</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  {currentSeries && (
    <div class="mt-8 overflow-hidden rounded-2xl bg-obsidian text-white shadow-xl lg:grid lg:grid-cols-12">
      <div class="flex items-center justify-center bg-charcoal p-5 sm:p-8 lg:col-span-7">
        <img
          src={url(currentSeries.data.coverImage)}
          alt={currentSeries.data.title}
          loading="lazy"
          decoding="async"
          class="w-full rounded-xl object-contain shadow-lg"
        />
      </div>
      <div class="flex flex-col justify-center p-8 lg:col-span-5 lg:p-10">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-accent">
          Current Series &bull; {currentSeries.data.book}
        </span>
        <h3 class="mt-3 font-display text-2xl font-extrabold text-white sm:text-3xl">
          {currentSeries.data.title}
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-stone-300 sm:text-base">
          {currentSeries.data.description}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={url(`/sermons/${currentSeries.id}`)}
            class="inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-bold text-obsidian hover:bg-accent-hover transition-colors"
          >
            Watch Series ({currentSeries.data.episodes.length} messages)
          </a>
          <a
            href={SITE.social.youtubeStreams}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-white/20 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
          >
            Sunday Livestream
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {recentSeries.map((series) => (
      <SeriesCard
        slug={series.id}
        title={series.data.title}
        book={series.data.book}
        coverImage={series.data.coverImage}
        episodeCount={series.data.episodes.length}
      />
    ))}
  </div>
</section>
