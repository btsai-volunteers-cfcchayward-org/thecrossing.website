---
import { url } from '../../lib/url';
---

<section class="relative overflow-clip bg-obsidian py-20 text-white sm:py-24">
  <img
    src={url('/images/site/worship-stage.webp')}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="parallax-media absolute inset-0 h-full w-full object-cover opacity-10"
  />
  <div
    class="absolute inset-0 bg-gradient-to-r from-obsidian via-obsidian/95 to-obsidian/80"
    aria-hidden="true"
  />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">Our Vision</p>
        <blockquote class="mt-4 font-serif text-3xl italic leading-snug text-white sm:text-5xl my-2">
          “THE CROSSING is an English-speaking, multiethnic ministry crossing generations and cultures together in Christ to love God, love people, and serve the world.”
        </blockquote>
        <p class="mt-6 text-base leading-relaxed text-stone-300">
          As the English-speaking ministry of Chinese For Christ Church of Hayward, we serve Hayward, Castro Valley, San Leandro, San Lorenzo, Union City, and beyond with a heart to cross generations and cultures in Christ.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={url('/im-new/our-church')}
            class="inline-flex items-center rounded-lg bg-white px-5 py-3 text-sm font-bold text-obsidian hover:bg-stone-200 transition-colors"
          >
            About Our Church
          </a>
          <a
            href={url('/im-new/our-beliefs')}
            class="inline-flex items-center rounded-lg border border-white/25 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
          >
            What We Believe
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 border-t border-white/15 lg:border-t-0 lg:border-l lg:pl-10 pt-8 lg:pt-0">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-stone-400">Six Core Values</p>
        <ol class="mt-4 divide-y divide-white/15">
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">01</span>
              <span class="font-display text-base font-semibold text-white">Experience God's Truth</span>
            </li>
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">02</span>
              <span class="font-display text-base font-semibold text-white">Reach People</span>
            </li>
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">03</span>
              <span class="font-display text-base font-semibold text-white">Authentic Community</span>
            </li>
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">04</span>
              <span class="font-display text-base font-semibold text-white">Maximize Involvement</span>
            </li>
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">05</span>
              <span class="font-display text-base font-semibold text-white">Family Across Generations &amp; Cultures</span>
            </li>
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-mono text-xs font-semibold text-accent">06</span>
              <span class="font-display text-base font-semibold text-white">Worship God</span>
            </li>
        </ol>
      </div>
    </div>
  </div>
</section>
