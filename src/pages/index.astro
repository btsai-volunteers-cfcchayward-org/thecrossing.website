---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeVisitorIndex from '../components/home/HomeVisitorIndex.astro';
import HomeLifeTogether from '../components/home/HomeLifeTogether.astro';
import HomeLatestSermons from '../components/home/HomeLatestSermons.astro';
import HomeVision from '../components/home/HomeVision.astro';
import HomeGetConnected from '../components/home/HomeGetConnected.astro';
import HomeVisit from '../components/home/HomeVisit.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={SITE.name}>
  <!-- Editorial Asymmetric Dark Hero -->
  <HomeHero />

  <!-- Hairline-Ruled First-Time Visitor Index (Anti-Template) -->
  <HomeVisitorIndex />

  <!-- Life Together Bento Gallery -->
  <HomeLifeTogether />

  <!-- Latest Teaching / Sermons -->
  <HomeLatestSermons />

  <!-- Editorial Vision & Values Dark Band -->
  <HomeVision />

  <!-- Asymmetric Editorial Get Connected Showcase (Breaks 3x2 SaaS Card Grid) -->
  <HomeGetConnected />

  <!-- Location & Map -->
  <HomeVisit />
</BaseLayout>
