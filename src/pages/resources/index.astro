---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { url } from '../../lib/url';
---

<BaseLayout title="Resources" description="Spiritual growth, family, and community care resources at The Crossing.">
  <PageHeader
    title="Resources"
    eyebrow="Equipping & Care"
    subtitle="Classes, media libraries, youth programs, and community care resources for you and your family."
    breadcrumbs={[{ label: 'Resources' }]}
  />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <a
        href={url('/resources/ce')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Sundays • 11:15 AM • Room 202</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            Christian Education (CE)
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">Workshops and classes on a broad range of topics designed to equip believers for life and faith.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/after-school-program')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Mon–Thu • 3:30 – 5:30 PM • Free</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            After-School Program
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">Kids Homework Club for Kindergarten – 7th Grade with homework help, arts &amp; crafts, games, and snacks.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/groceries')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Community Support</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            Groceries &amp; Care
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">Trusted local grocery and food assistance through Bridging Grace and Alameda County Community Food Bank.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/rightnow-media')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Free Church Subscription</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            RightNow Media
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">Access over 20,000 video Bible studies for small groups, families, and personal growth.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/audiobooks-on-hoopla')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Free with Library Card</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            Audiobooks on Hoopla
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">Recommended Christian audiobooks available free through your local public library on Hoopla Digital.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/how-to-practice-lent')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Devotional Guide</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            How to Practice Lent
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">A practical seasonal guide to fasting, prayer, and reflection leading up to Easter.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
      <a
        href={url('/resources/poetry')}
        class="group flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-7 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-md"
      >
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-hover">Reflections</span>
          <h2 class="mt-2 font-display text-xl font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
            Poetry
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">A small collection of poems from across centuries and cultures, shared for reflection and worship.</p>
        </div>
        <p class="mt-6 text-xs font-bold uppercase tracking-wider text-stone-900 group-hover:text-accent-hover">
          Explore &rarr;
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
