---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import EmbedFrame from '../../../components/EmbedFrame.astro';
import { url } from '../../../lib/url';

const scheduleEmbed =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/htmlembed';
const scheduleOpen =
  'https://docs.google.com/spreadsheets/d/1lsuomS3ifwFyo0NsKC6M33LbSWk8u-krvo3neEpscc8/pubhtml';
---

<BaseLayout title="Christian Education" description="Sunday 11:15 AM Christian Education workshops and classes at The Crossing.">
  <PageHeader
    title="Christian Education"
    eyebrow="Resources • Sundays 11:15 AM"
    subtitle="Workshops and classes after Sunday service designed to equip you in Scripture, theology, and everyday Christian living."
    breadcrumbs={[{ label: 'Resources', href: '/resources' }, { label: 'Christian Education' }]}
  />

  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8 space-y-12">
    <div class="grid divide-y divide-stone-300 border-y border-stone-300 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="py-7 sm:pr-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">01 / Where</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Room 202 (Adults)</p>
        <p class="mt-1 text-xs text-stone-500">Youth CE: Room 201 (MS) &amp; 204 (HS)</p>
      </div>
      <div class="py-7 sm:px-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">02 / When</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Sundays, 11:15 AM – 12:15 PM</p>
        <p class="mt-1 text-xs text-stone-500">Check schedule below for active dates</p>
      </div>
      <div class="py-7 sm:pl-6">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-accent-hover">03 / Questions?</p>
        <p class="mt-2 font-display text-lg font-bold text-stone-900">Derrick Tao &amp; CE Core</p>
        <p class="mt-1 text-xs text-stone-500">
          Suggest topics via{' '}
          <a href="mailto:church.office@cfcchayward.org?subject=Christian%20Education%20Inquiry" class="font-semibold text-accent-hover underline">
            church.office@cfcchayward.org
          </a>
        </p>
      </div>
    </div>

    <EmbedFrame
      src={scheduleEmbed}
      title="Christian Education Schedule"
      heightClass="h-[460px]"
      openLabel="Open Schedule Sheet"
      openHref={scheduleOpen}
    />

    <div>
      <h2 class="font-display text-2xl font-extrabold text-stone-900">Previous Classes</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <a
            href={url('/resources/ce/shepherding-101')}
            class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all hover:border-accent/50 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              Shepherding 101 &rarr;
            </h3>
            <p class="mt-1.5 text-sm text-stone-600">Equipping small group leaders and shepherds.</p>
          </a>
          <a
            href={url('/resources/ce/together-ce')}
            class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all hover:border-accent/50 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              Together CE &rarr;
            </h3>
            <p class="mt-1.5 text-sm text-stone-600">RightNow Media video series on community.</p>
          </a>
          <a
            href={url('/resources/ce/why-believe')}
            class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all hover:border-accent/50 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              Why Believe? CE &rarr;
            </h3>
            <p class="mt-1.5 text-sm text-stone-600">Apologetics and exploring Christian faith.</p>
          </a>
          <a
            href={url('/resources/ce/you-and-me-forever')}
            class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-xs transition-all hover:border-accent/50 hover:shadow-md"
          >
            <h3 class="font-display text-lg font-bold text-stone-900 group-hover:text-accent-hover transition-colors">
              You and Me Forever &rarr;
            </h3>
            <p class="mt-1.5 text-sm text-stone-600">Marriage and eternity by Francis &amp; Lisa Chan.</p>
          </a>
      </div>
    </div>
  </section>
</BaseLayout>
