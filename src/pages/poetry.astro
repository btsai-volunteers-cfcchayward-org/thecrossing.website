---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Poetry"
  description="Poetry from The Crossing, shared as a place for reflection, worship, and creative expression."
>
  <PageHeader
    title="Poetry"
    eyebrow="Reflections"
    subtitle="A collection of poems from our community is coming soon."
    breadcrumbs={[{ label: 'Poetry' }]}
  />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="border-l-2 border-accent pl-6 space-y-4">
      <p class="text-base leading-relaxed text-stone-700">
        We are preparing this page to share poetry with you. Please check back soon, or contact the church office if you would like to share a poem.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href={url('/contact-us')}
          class="inline-flex items-center rounded-lg bg-obsidian px-5 py-2.5 text-sm font-bold text-white hover:bg-slate-dark transition-colors"
        >
          Contact Us
        </a>
        <a
          href={url('/')}
          class="inline-flex items-center rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-800 hover:bg-stone-100 transition-colors"
        >
          Back to Home
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
